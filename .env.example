# DukaanPilot AI Environment Variables Example
# Duplicate this file as .env for local overrides

# Database Configuration
# Local default: dukaanpilot.db in project root
DATABASE_PATH=dukaanpilot.db

# Ollama / Local AI Inference
# Ensure Ollama is running: ollama run gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=6.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Static Files Path (for production single-service serving)
STATIC_DIR=frontend/dist
